# Quince – Konfiguration für Docker Compose
# Kopieren nach .env und anpassen:  cp .env.example .env

# Welcher Image-Tag von ghcr.io/dmyrenne/quince gezogen wird. "latest" folgt der
# jeweils neuesten Version; für einen festgenagelten Stand hier z. B. 0.1.0
# eintragen. Wird ignoriert, wenn in docker-compose.yml auf "build: ." umgestellt.
QUINCE_VERSION=latest

# Port, unter dem Quince auf dem Host erreichbar ist.
QUINCE_PORT=3000

# Die URL, unter der Quince tatsächlich aufgerufen wird – muss zu QUINCE_PORT passen.
# WICHTIG: Stimmt sie nicht, blockt SvelteKits CSRF-Schutz jeden Upload mit
# "Cross-site POST form submissions are forbidden".
# Hinter einem Reverse Proxy z. B.: ORIGIN=https://rezepte.example.com
ORIGIN=http://localhost:3000

# Wo die Rezepte auf dem Host liegen (Bind-Mount oder Volume-Name).
QUINCE_DATA=./data

# Maximale Upload-Größe. Fotos stecken base64-kodiert im Rezept-JSON, eine
# komplette .melarecipes-Bibliothek kommt schnell auf zig MB.
BODY_SIZE_LIMIT=128M

# Nur für öffentlich erreichbare Instanzen OHNE Volume/Bind-Mount gedacht
# (z. B. eine Demo, die jeder im Internet aufrufen kann): Hochgeladene Rezepte
# landen dann nur im Arbeitsspeicher für die Dauer der Anzeige, nie auf der
# Platte — es gibt keine Bibliothek und keine Seitenleiste, nur "Datei hochladen,
# ansehen". Für den normalen Selfhosting-Betrieb mit eigener Rezeptsammlung
# auskommentiert lassen (Standard: aus).
# READ_ONLY=true
